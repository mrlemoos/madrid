# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
tsconfig.tsbuildinfo

# dependencies
node_modules
.pnpm-store/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.claude/worktrees
.claude/settings.local.json

vite.config.*.timestamp*
vitest.config.*.timestamp*

# Supabase CLI local metadata (may contain connection strings)
supabase/.temp/

# Astro generated types (marketing site)
apps/nota-marketing/.astro/

# Local env anywhere in the workspace; only the .example templates are tracked.
# Repo-wide so a new app can never leak secrets by omitting its own rule.
**/.env
**/.env.*
!**/.env.example
.nx/polygraph

