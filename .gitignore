node_modules/
.expo/
.yarn/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
cache/


# Next.js
apps/nota/.next/
apps/nota/next-env.d.ts
# Storybook
storybook-static/

.nx/self-healing
.nx/migrate-runs
