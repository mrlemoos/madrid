{
  "name": "@nota/nota-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "nx": {
    "name": "@nota/nota-mobile",
    "sourceRoot": "apps/nota-mobile",
    "projectType": "application",
    "tags": [
      "scope:nota",
      "type:app",
      "platform:mobile"
    ],
    "targets": {
      "ensure-symlink": {
        "executor": "@nx/expo:ensure-symlink"
      },
      "sync-deps": {
        "executor": "@nx/expo:sync-deps"
      }
    }
  },
  "scripts": {
    "start": "expo start --ios",
    "dev_": "expo start --ios --clear",
    "dev:ios": "expo start --ios --clear",
    "dev:android": "expo start --android --clear",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@10play/tentap-editor": "*",
    "@clerk/expo": "^3.2.0",
    "@expo/metro": "~56.0.0",
    "@expo/metro-runtime": "~56.0.14",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/source-serif-4": "catalog:",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/instrument-serif": "catalog:",
    "@nota/database-types": "workspace:*",
    "@nota/internal-note-link": "workspace:*",
    "@nota/mobile-editor": "workspace:*",
    "@nota/nota-server-client": "workspace:*",
    "@nota/note-editor-settings": "workspace:*",
    "@nota/note-link-graph": "workspace:*",
    "@nota/notes-offline-core": "workspace:*",
    "@nota/validation": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "expo": "~56.0.18",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.17",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.6",
    "react": "catalog:",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "13.16.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/cli": "~56.1.14",
    "@types/react": "catalog:",
    "getenv": "^2.0.0",
    "typescript": "catalog:"
  },
  "expo": {
    "router": {
      "root": "./app"
    }
  }
}
