{
  "name": "@getmadrid/nota-electron",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "author": "Leonardo Lemos <leo@mrlemoos.dev>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@getmadrid/clerk-oauth-protocol": "workspace:*",
    "electron-updater": "^6.8.9",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/wait-on": "^5.3.4",
    "electron": "catalog:",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.0.1",
    "typescript": "catalog:",
    "wait-on": "^8.0.0"
  },
  "nx": {
    "sourceRoot": "apps/nota-electron/src",
    "projectType": "application",
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/nota-electron",
          "command": "pnpm exec vitest run"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "target": "build",
            "projects": "@getmadrid/clerk-oauth-protocol"
          }
        ],
        "options": {
          "commands": [
            "cd apps/nota-electron && tsc"
          ]
        }
      },
      "dev": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "target": "build",
            "projects": "@getmadrid/clerk-oauth-protocol"
          }
        ],
        "options": {
          "commands": [
            "echo 'Loads http://localhost:3000 — run `nx run-many -t dev` to start the Next app and Electron together.'",
            "cd apps/nota-electron && pnpm run build && pnpm exec electron ."
          ]
        }
      },
      "electron:pack": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "target": "build",
            "projects": "self"
          }
        ],
        "options": {
          "commands": [
            "pnpm exec rimraf apps/nota-electron/release && cd apps/nota-electron && pnpm exec electron-builder"
          ]
        }
      },
      "electron:release": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "target": "build",
            "projects": "self"
          }
        ],
        "options": {
          "cwd": ".",
          "command": "node tools/electron-github-release.mjs",
          "forwardAllArgs": true
        }
      }
    },
    "tags": [
      "scope:getmadrid",
      "type:app",
      "platform:node"
    ]
  }
}
