{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "src/content.config.ts",
    "astro.config.mjs"
  ],
  "references": [
    {
      "path": "../../packages/design"
    },
    {
      "path": "../../packages/note-doc-plain-text"
    }
  ]
}
