{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "src/content.config.ts",
    "scripts/**/*.ts",
    "astro.config.mjs",
    "vitest.config.mts"
  ],
  "references": [
    {
      "path": "../../packages/design"
    },
    {
      "path": "../../packages/note-doc-plain-text"
    }
  ]
}
