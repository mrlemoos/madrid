---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  lede: string;
  breadcrumb: string;
  /** ISO date shown as the last update. */
  updated: string;
}

const { title, description, heading, lede, breadcrumb, updated } = Astro.props;

const site = Astro.site;
if (!site) {
  throw new Error('Marketing site requires `site` in astro.config.');
}
const siteRoot = new URL('/', site).href;
const pageUrl = new URL(Astro.url.pathname, site).href;

const updatedLabel = new Date(updated).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
        { '@type': 'ListItem', position: 2, name: breadcrumb, item: pageUrl },
      ],
    },
    {
      '@type': 'WebPage',
      name: title,
      description,
      url: pageUrl,
      dateModified: updated,
      isPartOf: { '@type': 'WebSite', name: 'Madrid', url: siteRoot },
    },
  ],
};
---

<BaseLayout title={title} description={description} image="/og-default.png">
  <script type="application/ld+json" slot="head-extras" is:inline set:html={JSON.stringify(structuredData)} />
  <main id="main-content">
    <SiteHeader />
    <div class="mkt-container--prose mkt-section max-w-3xl">
      <h1 class="mkt-display">{heading}</h1>
      <p class="mkt-lede mt-6">{lede}</p>
      <p class="mt-4 text-sm text-muted-foreground">Last updated {updatedLabel}</p>
      <div class="mkt-prose mt-14">
        <slot />
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
