---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DownloadMacButton from '@/components/DownloadMacButton.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { MKT_THEME_COLOR_HERO } from '@/lib/marketing-theme';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede: string;
  /** Breadcrumb label; the path comes from the current URL. */
  breadcrumb: string;
  image?: string;
}

const { title, description, eyebrow, heading, lede, breadcrumb, image = '/og-default.png' } = Astro.props;

const site = Astro.site;
if (!site) {
  throw new Error('Marketing site requires `site` in astro.config.');
}
const siteRoot = new URL('/', site).href;
const pageUrl = new URL(Astro.url.pathname, site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
    { '@type': 'ListItem', position: 2, name: breadcrumb, item: pageUrl },
  ],
};
---

<BaseLayout title={title} description={description} image={image} themeColor={MKT_THEME_COLOR_HERO}>
  <script type="application/ld+json" slot="head-extras" is:inline set:html={JSON.stringify(structuredData)} />
  <main id="main-content">
    <div class="mkt-dark mkt-hero-band overflow-hidden">
      <SiteHeader borderless />
      <section class="mkt-container relative z-10 pt-16 pb-20 md:pt-20 md:pb-24">
        <div class="max-w-2xl">
          <p class="mkt-eyebrow">{eyebrow}</p>
          <h1 class="mkt-display">{heading}</h1>
          <p class="mkt-lede mt-6">{lede}</p>
        </div>
      </section>
    </div>

    <slot />

    <section class="mkt-container mkt-section border-t border-border" data-reveal>
      <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
        <div class="max-w-md">
          <h2 class="mkt-heading">Write in it today</h2>
          <p class="mkt-lede mt-4">Install the Mac app, sign in, and subscribe from Settings.</p>
        </div>
        <div class="flex flex-col gap-4 sm:flex-row">
          <DownloadMacButton />
          <a href="/pricing" class="mkt-btn mkt-btn--secondary mkt-focus">See pricing</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
