---
import GitHubIcon from '@/components/GitHubIcon.astro';
import { NOTA_APP_URL, NOTA_DOWNLOAD_PATH, NOTA_GITHUB_REPO } from '@/lib/site';

interface Props {
  borderless?: boolean;
}

const { borderless = false } = Astro.props;

/** Homepage hero surfaces the product pages first; other pages lead with Download. */
const productLinks = [
  { href: '/writing', label: 'Writing' },
  { href: '/graph', label: 'Graph' },
  { href: '/sync', label: 'Sync' },
];

const navLinks = borderless
  ? [...productLinks, { href: '/pricing', label: 'Pricing' }, { href: '/blog', label: 'Blog' }]
  : [
      { href: NOTA_DOWNLOAD_PATH, label: 'Download' },
      ...productLinks,
      { href: '/pricing', label: 'Pricing' },
      { href: '/blog', label: 'Blog' },
    ];
---

<header
  class:list={[
    'mkt-safari-top-chrome sticky top-0 z-50 px-5 py-4 text-foreground backdrop-blur-md md:px-8',
    !borderless && 'border-b border-border/60',
  ]}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6">
    <a href="/" class="mkt-focus inline-flex items-center" aria-label="Madrid home">
      <img src="/madrid-logo.svg" alt="Madrid" class="h-7 w-auto" />
    </a>
    <nav class="flex flex-wrap items-center justify-end gap-x-6 gap-y-2 text-sm font-medium">
      {
        navLinks.map(({ href, label }) => (
          <a href={href} class="mkt-focus text-muted-foreground transition hover:text-foreground">
            {label}
          </a>
        ))
      }
      <a
        href={NOTA_APP_URL}
        class="mkt-focus hidden text-muted-foreground transition hover:text-foreground sm:inline"
        rel="noopener noreferrer"
      >
        Open in browser
      </a>
      <a
        href={NOTA_GITHUB_REPO}
        class="mkt-focus inline-flex size-9 items-center justify-center rounded-[var(--radius-sm)] text-muted-foreground transition hover:bg-muted hover:text-foreground"
        rel="noopener noreferrer"
        target="_blank"
        aria-label="Madrid on GitHub"
      >
        <GitHubIcon />
      </a>
    </nav>
  </div>
</header>
