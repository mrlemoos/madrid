---
import SlideArrowDownloadButton from '@/components/SlideArrowDownloadButton';
import { NOTA_GITHUB_LATEST } from '@/lib/site';

interface Props {
  class?: string;
  variant?: 'hero' | 'page';
}

const { class: className, variant = 'page' } = Astro.props;
---

<SlideArrowDownloadButton
  client:load
  href={NOTA_GITHUB_LATEST}
  className={className}
  variant={variant}
/>
