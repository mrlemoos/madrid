---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DownloadMacButton from '@/components/DownloadMacButton.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { MKT_THEME_COLOR_PAGE } from '@/lib/marketing-theme';
import { NOTA_PRICE_ANNUAL_USD, NOTA_PRICE_MONTHLY_USD } from '@/lib/site';

const site = Astro.site;
if (!site) {
  throw new Error('Marketing site requires `site` in astro.config.');
}
const siteRoot = new URL('/', site).href;
const pricingUrl = new URL('/pricing', site).href;

const priceMonthlyUsd = NOTA_PRICE_MONTHLY_USD;
const priceAnnualUsd = NOTA_PRICE_ANNUAL_USD;
const priceAnnualMonthlyUsd = (Number.parseFloat(priceAnnualUsd) / 12).toFixed(2);

const pricingTitle = 'Madrid pricing: from $2.49/month';
const pricingDescription =
  'Madrid is a paid Mac notes app: subscribe in-app for cloud sync and backup. Guide prices $19.49/year or $2.49/month (USD); lifetime offered when available in checkout.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteRoot,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Pricing',
          item: pricingUrl,
        },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Madrid',
      operatingSystem: 'macOS',
      applicationCategory: 'ProductivityApplication',
      description:
        'Native Mac notes app. Subscribe inside the app after install for full access, cloud sync, and backup.',
      url: siteRoot,
      offers: [
        {
          '@type': 'Offer',
          name: 'Madrid, annual',
          price: priceAnnualUsd,
          priceCurrency: 'USD',
          description: 'Full app access; billed annually. Subscribe from Settings in the macOS app.',
          availability: 'https://schema.org/OnlineOnly',
          url: pricingUrl,
        },
        {
          '@type': 'Offer',
          name: 'Madrid, monthly',
          price: priceMonthlyUsd,
          priceCurrency: 'USD',
          description: 'Full app access; billed monthly. Subscribe from Settings in the macOS app.',
          availability: 'https://schema.org/OnlineOnly',
          url: pricingUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  image="/og/pricing.png"
  title={pricingTitle}
  description={pricingDescription}
  themeColor={MKT_THEME_COLOR_PAGE}
>
  <script type="application/ld+json" slot="head-extras" is:inline set:html={JSON.stringify(structuredData)} />
  <main id="main-content">
    <SiteHeader />
    <div class="mkt-container mkt-section">
      <p class="mkt-eyebrow">Pricing</p>
      <h1 class="mkt-display">One subscription, the whole app</h1>
      <p class="mkt-lede mt-6 max-w-2xl">
        Figures below are guide prices in US Dollars. Checkout inside the app shows the final charge in your currency,
        and tax may apply where you live.
      </p>

      <div class="mt-16 grid gap-14 md:grid-cols-3 md:gap-x-12 md:gap-y-0 lg:gap-x-16">
        <article class="flex flex-col" data-reveal>
          <h2 class="font-serif text-2xl font-normal text-foreground">Annual</h2>
          <p class="mt-3 text-3xl font-semibold tracking-tight text-foreground">
            {'$' + priceAnnualMonthlyUsd}
            <span class="text-xl font-normal text-muted-foreground"> / month</span>
          </p>
          <p class="mt-1 text-sm text-muted-foreground">Billed annually at ${priceAnnualUsd}</p>
          <p class="mt-4 text-sm font-medium text-foreground">Save about 35% against monthly</p>
          <ul class="mt-6 space-y-2 text-sm leading-relaxed text-muted-foreground">
            <li>The full app, including the note graph and attachments</li>
            <li>Cloud sync and backup</li>
            <li>Use it on every Mac you sign in on</li>
          </ul>
        </article>

        <article class="flex flex-col" data-reveal>
          <h2 class="font-serif text-2xl font-normal text-foreground">Monthly</h2>
          <p class="mt-3 text-3xl font-semibold tracking-tight text-foreground">
            {'$' + priceMonthlyUsd}
            <span class="text-xl font-normal text-muted-foreground"> / month</span>
          </p>
          <p class="mt-1 text-sm text-muted-foreground">Billed monthly</p>
          <ul class="mt-10 space-y-2 text-sm leading-relaxed text-muted-foreground">
            <li>Everything in annual</li>
            <li>Cancel from your billing settings</li>
          </ul>
        </article>

        <article class="flex flex-col" data-reveal>
          <h2 class="font-serif text-2xl font-normal text-foreground">Lifetime</h2>
          <p class="mt-3 text-3xl font-semibold tracking-tight text-foreground">In-app</p>
          <p class="mt-1 text-sm text-muted-foreground">One-time purchase</p>
          <p class="mt-10 text-sm leading-relaxed text-muted-foreground">
            When your build of Madrid offers it, lifetime sits beside monthly and annual at checkout.
          </p>
        </article>
      </div>

      <div class="mt-20 border-t border-border pt-12">
        <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
          <div class="max-w-md">
            <h2 class="mkt-heading">How buying works</h2>
            <p class="mkt-lede mt-4">
              Download the Mac app, sign in, and subscribe from Settings. There is no free tier, so nothing expires and
              nothing nags you.
            </p>
            <p class="mt-4 text-sm text-muted-foreground">
              Our <a href="/refunds" class="mkt-link mkt-focus">refund policy</a> covers web-billed subscriptions.
            </p>
          </div>
          <DownloadMacButton />
        </div>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
