---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DownloadMacButton from '@/components/DownloadMacButton.astro';
import FeatureRow from '@/components/FeatureRow.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import editorOverviewImage from '@/assets/marketing/editor-overview.png';
import noteGraphImage from '@/assets/marketing/note-graph.png';
import heroScreenshotImage from '@/assets/marketing/desktop-app-screenshot.png';
import { MKT_THEME_COLOR_HERO } from '@/lib/marketing-theme';
import {
  NOTA_GITHUB_LATEST,
  NOTA_GITHUB_RELEASES,
  NOTA_GITHUB_REPO,
  NOTA_PRICE_ANNUAL_USD,
  NOTA_PRICE_MONTHLY_USD,
} from '@/lib/site';

const site = Astro.site;
if (!site) {
  throw new Error('Marketing site requires `site` in astro.config.');
}
const siteRoot = new URL('/', site).href;
const downloadUrl = NOTA_GITHUB_LATEST;
const heroScreenshotUrl = new URL(heroScreenshotImage.src, site).href;

const priceMonthlyUsd = NOTA_PRICE_MONTHLY_USD;
const priceAnnualUsd = NOTA_PRICE_ANNUAL_USD;

const homeTitle = 'Madrid: Quiet Mac Notes';
const homeDescription =
  'A native Mac notes app that protects your attention. No feeds, no nudges, just a calm place to write and link ideas. Subscribe in-app after install.';

const faqEntities = [
  {
    '@type': 'Question',
    name: 'Is there a free tier or trial?',
    acceptedAnswer: {
      '@type': 'Answer',
      text:
        'No. Download the Mac app from GitHub Releases, create an account, then subscribe in Settings to use Madrid. USD guide prices are on the pricing page; checkout in the app shows the final charge.',
    },
  },
  {
    '@type': 'Question',
    name: 'What does a subscription include?',
    acceptedAnswer: {
      '@type': 'Answer',
      text:
        'Full access to writing, the note graph, attachments, and cloud sync with secure backup across devices where you use Madrid while signed in.',
    },
  },
  {
    '@type': 'Question',
    name: 'Does Madrid work offline?',
    acceptedAnswer: {
      '@type': 'Answer',
      text:
        'Yes. Notes are written to local storage first and sync when you are back online, so a lost connection never blocks writing.',
    },
  },
  {
    '@type': 'Question',
    name: 'Where are my notes stored?',
    acceptedAnswer: {
      '@type': 'Answer',
      text:
        'On your Mac, and in your own row-secured space in the cloud while you are signed in. Attachments live in private storage and are served through short-lived links.',
    },
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteRoot}#organization`,
      name: 'Madrid',
      url: siteRoot,
      sameAs: [NOTA_GITHUB_REPO],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteRoot}#website`,
      url: siteRoot,
      name: 'Madrid',
      description: homeDescription,
      publisher: { '@id': `${siteRoot}#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteRoot}#software`,
      name: 'Madrid',
      operatingSystem: 'macOS',
      applicationCategory: 'ProductivityApplication',
      description: homeDescription,
      url: siteRoot,
      downloadUrl,
      screenshot: heroScreenshotUrl,
      author: {
        '@type': 'Person',
        name: 'Leonardo Lemos',
        url: 'https://mrlemoos.dev',
      },
      publisher: { '@id': `${siteRoot}#organization` },
      offers: [
        {
          '@type': 'Offer',
          name: 'Madrid, monthly',
          price: priceMonthlyUsd,
          priceCurrency: 'USD',
          description:
            'Full app access with cloud sync and backup. Billed monthly; subscribe from inside the macOS app after install.',
          availability: 'https://schema.org/OnlineOnly',
          url: `${siteRoot}pricing`,
        },
        {
          '@type': 'Offer',
          name: 'Madrid, annual',
          price: priceAnnualUsd,
          priceCurrency: 'USD',
          description:
            'Full app access with cloud sync and backup. Billed annually; subscribe from inside the macOS app after install.',
          availability: 'https://schema.org/OnlineOnly',
          url: `${siteRoot}pricing`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteRoot}#faq`,
      mainEntity: faqEntities,
    },
  ],
};

const macDetails = [
  {
    title: 'Native window chrome',
    body: 'Vibrancy, traffic lights, and a sidebar that behaves like a Mac rail rather than a web panel.',
  },
  {
    title: 'Keyboard first',
    body: 'Command palette on Mod+K, today’s note on Mod+D, history on Mod+[ and Mod+]. Keyboard actions never wait on animation.',
  },
  {
    title: 'Quiet by default',
    body: 'No streaks, no badges, no weekly report on how much you wrote.',
  },
];
---

<BaseLayout title={homeTitle} description={homeDescription} image="/og/home.png" themeColor={MKT_THEME_COLOR_HERO}>
  <script type="application/ld+json" slot="head-extras" is:inline set:html={JSON.stringify(structuredData)} />
  <main id="main-content">
    <div class="mkt-dark mkt-hero-band overflow-hidden">
      <SiteHeader borderless />

      <section class="mkt-container relative z-10 pt-16 pb-16 md:pt-20 md:pb-20" aria-labelledby="hero-heading">
        <div class="mx-auto flex max-w-2xl flex-col items-center gap-10 text-center md:gap-12 lg:max-w-3xl">
          <h1 id="hero-heading" class="mkt-display lg:text-[3.25rem]">Think without the feed.</h1>
          <p class="mkt-lede">
            A native Mac notes app for writing and linking ideas. Madrid steps back when you pause.<br />
            <span class="text-foreground">No performance, no nudges.</span>
          </p>
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-5" id="download">
            <DownloadMacButton variant="hero" />
            <a
              href="/pricing"
              class="mkt-focus inline-flex min-h-11 items-center justify-center px-2 py-3 text-sm font-medium text-muted-foreground underline decoration-muted-foreground/40 underline-offset-4 transition hover:text-foreground"
            >
              Pricing
            </a>
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground/90">
            Install the Mac app, sign in, subscribe in Settings.
          </p>
        </div>

        <figure class="mx-auto mt-16 w-full max-w-5xl md:mt-20">
          <div class="mkt-shot p-1.5">
            <video
              class="h-auto w-full rounded-[calc(var(--radius)-2px)]"
              poster="/video/nota-hero-poster.jpg"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Madrid on macOS: writing in a note, opening the command palette, and following a link to another note"
            >
              <source src="/video/nota-hero.webm" type="video/webm" />
              <source src="/video/nota-hero.mp4" type="video/mp4" />
            </video>
          </div>
        </figure>
      </section>
    </div>

    <section class="mkt-container mkt-section--tight border-b border-border" data-reveal>
      <p class="mkt-heading mx-auto max-w-3xl text-center">
        One window, your words, and the links between them. Everything else stays out of the way.
      </p>
    </section>

    <FeatureRow
      eyebrow="Writing"
      title="An editor that steps back"
      image={editorOverviewImage}
      alt="A note open in Madrid: serif title, plain paragraphs, and no toolbar hovering over the text"
      href="/writing"
      linkLabel="More about writing"
    >
      <p>
        Rich text without the chrome. Headings, lists, tables, code, and images live in the document, and the controls
        appear where you need them rather than along the top of the window.
      </p>
      <p>Drag a PDF in and it stays in the note at the point you dropped it.</p>
    </FeatureRow>

    <FeatureRow
      eyebrow="Links"
      title="Connections you can see"
      image={noteGraphImage}
      alt="The Madrid note graph: labelled nodes joined by thin lines, one note highlighted with its neighbours"
      href="/graph"
      linkLabel="More about the note graph"
      reverse
    >
      <p>
        Type <code class="rounded-sm bg-muted px-1.5 py-0.5 text-sm">@</code> to link one note to another. There is no
        syntax to learn and no toolbar button to find.
      </p>
      <p>The graph shows what your notes have grown into, and you can leave any note out of it.</p>
    </FeatureRow>

    <FeatureRow
      eyebrow="Offline and sync"
      title="Your notes stay yours"
      image={heroScreenshotImage}
      alt="Madrid running on macOS over a soft cityscape: dark glass sidebar and a calm writing surface"
      href="/sync"
      linkLabel="More about offline and sync"
    >
      <p>
        Writing lands in local storage first. When the connection comes back, changes sync in the order you made them,
        with a backup you did not have to think about.
      </p>
      <p>On a plane, on a train, or with the wifi off, the app behaves the same way.</p>
    </FeatureRow>

    <section class="mkt-container mkt-section border-t border-border" aria-labelledby="mac-heading" data-reveal>
      <p class="mkt-eyebrow">Built for the Mac</p>
      <h2 id="mac-heading" class="mkt-heading max-w-xl">Not a web page in a window</h2>
      <dl class="mt-12 grid gap-10 md:grid-cols-3 md:gap-12">
        {
          macDetails.map(({ title, body }) => (
            <div>
              <dt class="font-medium text-foreground">{title}</dt>
              <dd class="mkt-lede mt-3 text-sm md:text-base">{body}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mkt-container mkt-section border-t border-border" aria-labelledby="price-heading" data-reveal>
      <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
        <div class="max-w-md">
          <p class="mkt-eyebrow">Pricing</p>
          <h2 id="price-heading" class="mkt-heading">
            ${priceAnnualUsd} a year, or ${priceMonthlyUsd} a month
          </h2>
          <p class="mkt-lede mt-5">
            One subscription covers the app, the graph, attachments, and sync. You subscribe from Settings after you
            install, and prices in checkout are shown in your currency.
          </p>
        </div>
        <div class="flex flex-col gap-4 sm:flex-row">
          <DownloadMacButton />
          <a href="/pricing" class="mkt-btn mkt-btn--secondary mkt-focus">See what is included</a>
        </div>
      </div>
    </section>

    <section id="faq" class="mkt-container mkt-section border-t border-border" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-2xl">
        <h2 id="faq-heading" class="mkt-heading mb-10">Common questions</h2>
        <dl class="space-y-8 text-sm md:text-base">
          <div>
            <dt class="font-medium text-foreground">Is there a free tier or trial?</dt>
            <dd class="mt-2 leading-relaxed text-muted-foreground">
              No. Download the Mac app from
              <a href={NOTA_GITHUB_RELEASES} class="mkt-link mkt-focus">GitHub Releases</a>, sign in, and subscribe in
              Settings to write and sync. See <a href="/pricing" class="mkt-link mkt-focus">pricing</a> for current USD guide
              prices.
            </dd>
          </div>
          <div>
            <dt class="font-medium text-foreground">What does a subscription include?</dt>
            <dd class="mt-2 leading-relaxed text-muted-foreground">
              Writing, internal links, the note graph, attachments, and cloud sync with backup while you are signed in.
            </dd>
          </div>
          <div>
            <dt class="font-medium text-foreground">Does Madrid work offline?</dt>
            <dd class="mt-2 leading-relaxed text-muted-foreground">
              Yes. Notes are written locally first and sync when you are back online, so a dropped connection never
              stops you writing.
            </dd>
          </div>
          <div>
            <dt class="font-medium text-foreground">Where are my notes stored?</dt>
            <dd class="mt-2 leading-relaxed text-muted-foreground">
              On your Mac, and in your own row-secured space in the cloud while you are signed in. Attachments sit in
              private storage and are served through short-lived links.
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
