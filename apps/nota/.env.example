# Vercel (dashboard): set the same keys for Production / Preview when deploying `apps/nota`.
# Project Root Directory = `apps/nota`; install/build are overridden by `apps/nota/vercel.json`
# (install from monorepo root, `nx build @nota/nota`).
# This project is a static SPA only; no `CLERK_SECRET_KEY` or serverless `api/*` on Vercel.

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Electron desktop OAuth: add redirect allowlist entry `nota://oauth-callback` (Clerk Dashboard → Redirect URLs).
# Server-only: used by the App Router route `/api/nota-pro-entitled` (Clerk Billing). Never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Supabase Configuration (Postgres + Storage; auth is Clerk + third-party JWT)
# Get these from your Supabase project dashboard: https://app.supabase.com
# Enable Clerk under Authentication → Third-party auth and run migration `0008_clerk_third_party_auth.sql`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Legacy: nota-server origin. The web/API endpoints are now served same-origin by
# the Next App Router (src/app/api/*), so this is no longer required for the app.
NEXT_PUBLIC_NOTA_SERVER_API_URL=

# --- Server-only API secrets (absorbed from nota-server; NEVER prefix NEXT_PUBLIC_) ---
# Semantic search: Supabase service role + embeddings provider.
SUPABASE_SERVICE_ROLE_KEY=
NOTA_SEMANTIC_EMBEDDINGS_API_KEY=
NOTA_SEMANTIC_EMBEDDINGS_API_BASE=
NOTA_SEMANTIC_EMBEDDINGS_MODEL=
NOTA_SEMANTIC_EMBEDDINGS_DIMENSIONS=
# Assistive capture (audio-to-note) via xAI.
XAI_API_KEY=
XAI_CHAT_MODEL=
# Public flight lookup (AirLabs) for the note flight-code feature.
AIRLABS_API_KEY=
# Release notes (optional GitHub token lifts the unauthenticated rate limit).
NOTA_GITHUB_REPO=mrlemoos/nota
GITHUB_TOKEN=
# Set to 1 to include error detail in semantic API JSON responses (debug only).
NOTA_SERVER_DEBUG_ERRORS=

# Optional: PostHog product analytics (client-side).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional: override the hosted web app origin for share links (no trailing slash).
# Falls back to window.location.origin on web; a prod default is used in packaged Electron.
NEXT_PUBLIC_NOTA_WEB_APP_ORIGIN=

# Optional: Stripe (https://dashboard.stripe.com/apikeys); use live keys only in production hosts; rotate if leaked.
# Publishable key (pk_live_… / pk_test_…): only needed if the SPA loads Stripe.js directly.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key: server-only; never use a `NEXT_PUBLIC_*` name for secrets.
STRIPE_SECRET_KEY=

# Optional (local / CI only): Supabase service role for admin SQL or one-off migrations; never expose to the client or commit real values
# SUPABASE_SERVICE_ROLE_KEY=
