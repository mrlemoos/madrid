{
  "name": "@getmadrid/notes-chrome-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./notes-chrome": {
      "@getmadrid/source": {
        "types": "./src/notes-chrome.tsx",
        "import": "./src/notes-chrome.tsx",
        "default": "./src/notes-chrome.tsx"
      },
      "types": "./src/notes-chrome.tsx",
      "import": "./src/notes-chrome.tsx",
      "default": "./src/notes-chrome.tsx"
    },
    "./notes-chrome-parts": {
      "@getmadrid/source": {
        "types": "./src/notes-chrome-parts.tsx",
        "import": "./src/notes-chrome-parts.tsx",
        "default": "./src/notes-chrome-parts.tsx"
      },
      "types": "./src/notes-chrome-parts.tsx",
      "import": "./src/notes-chrome-parts.tsx",
      "default": "./src/notes-chrome-parts.tsx"
    },
    "./notes-sidebar-list": {
      "@getmadrid/source": {
        "types": "./src/notes-sidebar-list.tsx",
        "import": "./src/notes-sidebar-list.tsx",
        "default": "./src/notes-sidebar-list.tsx"
      },
      "types": "./src/notes-sidebar-list.tsx",
      "import": "./src/notes-sidebar-list.tsx",
      "default": "./src/notes-sidebar-list.tsx"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:getmadrid",
      "type:feature",
      "platform:web"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/notes-chrome-ui",
          "command": "pnpm run build"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@getmadrid/app-navigation-core": "workspace:*",
    "@getmadrid/app-navigation-ui": "workspace:*",
    "@getmadrid/database-types": "workspace:*",
    "next": "catalog:",
    "@getmadrid/electron-bridge-core": "workspace:*",
    "@getmadrid/electron-bridge-ui": "workspace:*",
    "@getmadrid/i18n": "workspace:*",
    "@getmadrid/note-capture-ui": "workspace:*",
    "@getmadrid/note-editor-core": "workspace:*",
    "@getmadrid/note-editor-ui": "workspace:*",
    "@getmadrid/note-folders-core": "workspace:*",
    "@getmadrid/note-folders-ui": "workspace:*",
    "@getmadrid/note-journal-core": "workspace:*",
    "@getmadrid/note-runtime": "workspace:*",
    "@getmadrid/nota-motion-ui": "workspace:*",
    "@getmadrid/notes-chrome-core": "workspace:*",
    "@getmadrid/design": "workspace:*",
    "@getmadrid/writing-activity-core": "workspace:*",
    "react": "catalog:"
