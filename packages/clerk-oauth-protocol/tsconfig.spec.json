{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "rootDir": "."
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "__tests__/**/*.test.ts",
    "src/**/*.spec.ts",
    "__tests__/**/*.spec.ts",
    "src/**/*.test.tsx",
    "__tests__/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "__tests__/**/*.spec.tsx",
    "src/**/*.test.js",
    "__tests__/**/*.test.js",
    "src/**/*.spec.js",
    "__tests__/**/*.spec.js",
    "src/**/*.test.jsx",
    "__tests__/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "__tests__/**/*.spec.jsx",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
