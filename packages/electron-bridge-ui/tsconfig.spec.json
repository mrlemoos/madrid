{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "vite.config.mts",
    "vitest.setup.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/nota-electron-globals.d.ts"
  ],
  "references": [{ "path": "./tsconfig.lib.json" }]
}
