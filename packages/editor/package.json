{
  "name": "@getmadrid/editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@getmadrid/source": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:getmadrid",
      "type:feature",
      "platform:web"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/editor",
          "command": "pnpm run build"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@getmadrid/database-types": "workspace:*",
    "@getmadrid/design": "workspace:*",
    "@getmadrid/internal-note-link": "workspace:*",
    "@getmadrid/isomorphic-helpers": "workspace:*",
    "@getmadrid/link-platform-preview": "workspace:*",
    "@getmadrid/note-editor-settings": "workspace:*",
    "@getmadrid/notes-yjs-core": "workspace:*",
    "@tiptap/extension-code-block": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "2.11.5",
    "@tiptap/extension-collaboration": "^2.11.5",
    "@tiptap/extension-emoji": "^2.27.2",
    "@tiptap/extension-highlight": "2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "2.27.2",
    "lowlight": "^3.3.0",
    "mermaid": "^11.12.0",
    "pdfjs-dist": "^6.2.108",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.3",
    "react-dom": "^19.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
