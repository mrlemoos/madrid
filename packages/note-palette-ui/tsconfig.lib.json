{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx"],
  "references": [
    {
      "path": "../note-runtime/tsconfig.lib.json"
    },
    {
      "path": "../note-palette-core/tsconfig.lib.json"
    },
    {
      "path": "../note-journal-core/tsconfig.lib.json"
    },
    {
      "path": "../note-folders-ui/tsconfig.lib.json"
    },
    {
      "path": "../note-folders-core/tsconfig.lib.json"
    },
    {
      "path": "../note-capture-ui/tsconfig.lib.json"
    },
    {
      "path": "../nota-motion-ui/tsconfig.lib.json"
    },
    {
      "path": "../i18n/tsconfig.lib.json"
    },
    {
      "path": "../helper-hooks/tsconfig.lib.json"
    },
    {
      "path": "../electron-bridge-ui/tsconfig.lib.json"
    },
    {
      "path": "../electron-bridge-core/tsconfig.lib.json"
    },
    {
      "path": "../editor/tsconfig.lib.json"
    },
    {
      "path": "../design/tsconfig.lib.json"
    },
    {
      "path": "../database-types/tsconfig.lib.json"
    },
    {
      "path": "../app-navigation-ui/tsconfig.lib.json"
    },
    {
      "path": "../app-navigation-core/tsconfig.lib.json"
    },
    {
      "path": "../data-source/tsconfig.lib.json"
    }
  ]
}
