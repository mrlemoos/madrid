{
  "name": "@nota/note-palette-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./command-palette": {
      "@nota/source": {
        "types": "./src/command-palette.tsx",
        "import": "./src/command-palette.tsx",
        "default": "./src/command-palette.tsx"
      },
      "types": "./src/command-palette.tsx",
      "import": "./src/command-palette.tsx",
      "default": "./src/command-palette.tsx"
    },
    "./signed-in-command-palette": {
      "@nota/source": {
        "types": "./src/signed-in-command-palette.tsx",
        "import": "./src/signed-in-command-palette.tsx",
        "default": "./src/signed-in-command-palette.tsx"
      },
      "types": "./src/signed-in-command-palette.tsx",
      "import": "./src/signed-in-command-palette.tsx",
      "default": "./src/signed-in-command-palette.tsx"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:nota",
      "type:feature",
      "platform:web"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/note-palette-ui",
          "command": "pnpm run build"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@clerk/react": "^6.1.2",
    "@nota/app-navigation-core": "workspace:*",
    "@nota/app-navigation-ui": "workspace:*",
    "@nota/database-types": "workspace:*",
    "@nota/design": "workspace:*",
    "@nota/editor": "workspace:*",
    "@nota/electron-bridge-core": "workspace:*",
    "@nota/electron-bridge-ui": "workspace:*",
    "@nota/helper-hooks": "workspace:*",
    "@nota/i18n": "workspace:*",
    "@nota/nota-motion-ui": "workspace:*",
    "@nota/note-capture-ui": "workspace:*",
    "@nota/note-folders-core": "workspace:*",
    "@nota/note-folders-ui": "workspace:*",
    "@nota/note-journal-core": "workspace:*",
    "@nota/note-palette-core": "workspace:*",
    "@nota/note-runtime": "workspace:*",
    "cmdk": "^1.1.1",
    "grabkit": "^2.1.0",
    "react": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@nota/data-source": "workspace:*"
  }
}
