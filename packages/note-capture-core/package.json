{
  "name": "@getmadrid/note-capture-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./audio-note-blocks-to-doc": {
      "@getmadrid/source": {
        "types": "./src/audio-note-blocks-to-doc.ts",
        "import": "./src/audio-note-blocks-to-doc.ts",
        "default": "./src/audio-note-blocks-to-doc.ts"
      },
      "types": "./src/audio-note-blocks-to-doc.ts",
      "import": "./src/audio-note-blocks-to-doc.ts",
      "default": "./src/audio-note-blocks-to-doc.ts"
    },
    "./format-recording-duration": {
      "@getmadrid/source": {
        "types": "./src/format-recording-duration.ts",
        "import": "./src/format-recording-duration.ts",
        "default": "./src/format-recording-duration.ts"
      },
      "types": "./src/format-recording-duration.ts",
      "import": "./src/format-recording-duration.ts",
      "default": "./src/format-recording-duration.ts"
    },
    "./study-note-title": {
      "@getmadrid/source": {
        "types": "./src/study-note-title.ts",
        "import": "./src/study-note-title.ts",
        "default": "./src/study-note-title.ts"
      },
      "types": "./src/study-note-title.ts",
      "import": "./src/study-note-title.ts",
      "default": "./src/study-note-title.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:getmadrid",
      "type:util",
      "platform:shared"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/note-capture-core",
          "command": "pnpm run build"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@getmadrid/database-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
