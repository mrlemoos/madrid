{
  "name": "@getmadrid/helper-hooks",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@getmadrid/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:getmadrid",
      "type:util",
      "platform:shared"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "packages/helper-hooks",
          "command": "vite build && pnpm exec tsc -b tsconfig.lib.json"
        }
      }
    }
  }
}
