{
  "name": "@getmadrid/i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@getmadrid/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:getmadrid",
      "type:util",
      "platform:shared"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/i18n",
          "command": "pnpm run build"
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.lib.json"
  },
  "dependencies": {}
}
