      },
      "types": "./src/electron-menubar-payload.ts",
      "import": "./src/electron-menubar-payload.ts",
      "default": "./src/electron-menubar-payload.ts"
    },
    "./window-chrome": {
      "@getmadrid/source": {
        "types": "./src/electron-window-chrome.ts",
        "import": "./src/electron-window-chrome.ts",
        "default": "./src/electron-window-chrome.ts"
      },
      "types": "./src/electron-window-chrome.ts",
      "import": "./src/electron-window-chrome.ts",
      "default": "./src/electron-window-chrome.ts"
    },
    "./menubar-events": {
      "@getmadrid/source": {
        "types": "./src/electron-menubar-events.ts",
        "import": "./src/electron-menubar-events.ts",
        "default": "./src/electron-menubar-events.ts"
      },
      "types": "./src/electron-menubar-events.ts",
      "import": "./src/electron-menubar-events.ts",
      "default": "./src/electron-menubar-events.ts"
    },
    "./update-status": {
      "@getmadrid/source": {
