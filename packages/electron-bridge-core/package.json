        "default": "./src/nota-update-status.ts"
      },
      "types": "./src/nota-update-status.ts",
      "import": "./src/nota-update-status.ts",
      "default": "./src/nota-update-status.ts"
    },
    "./clipboard-plain-text": {
      "@getmadrid/source": {
        "types": "./src/clipboard-plain-text-to-tiptap-doc.ts",
        "import": "./src/clipboard-plain-text-to-tiptap-doc.ts",
        "default": "./src/clipboard-plain-text-to-tiptap-doc.ts"
      },
      "types": "./src/clipboard-plain-text-to-tiptap-doc.ts",
      "import": "./src/clipboard-plain-text-to-tiptap-doc.ts",
      "default": "./src/clipboard-plain-text-to-tiptap-doc.ts"
