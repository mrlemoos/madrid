{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "__tests__/**/*.spec.ts"
  ],
  "references": [{ "path": "./tsconfig.lib.json" }]
}
