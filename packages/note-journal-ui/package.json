{
  "name": "@getmadrid/note-journal-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./journal-screen": {
      "@getmadrid/source": {
        "types": "./src/journal-screen.tsx",
        "import": "./src/journal-screen.tsx",
        "default": "./src/journal-screen.tsx"
      },
      "types": "./src/journal-screen.tsx",
      "import": "./src/journal-screen.tsx",
      "default": "./src/journal-screen.tsx"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:getmadrid",
      "type:feature",
      "platform:web"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/note-journal-ui",
          "command": "pnpm run build"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@getmadrid/i18n": "workspace:*",
    "@getmadrid/nota-motion-ui": "workspace:*",
    "@getmadrid/note-journal-core": "workspace:*",
    "@getmadrid/note-runtime": "workspace:*",
    "@getmadrid/design": "workspace:*",
    "@tanstack/react-virtual": "^3.13.24",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
