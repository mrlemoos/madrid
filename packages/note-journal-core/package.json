{
  "name": "@getmadrid/note-journal-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./date-from-title": {
      "@getmadrid/source": {
        "types": "./src/journal-date-from-title.ts",
        "import": "./src/journal-date-from-title.ts",
        "default": "./src/journal-date-from-title.ts"
      },
      "types": "./src/journal-date-from-title.ts",
      "import": "./src/journal-date-from-title.ts",
      "default": "./src/journal-date-from-title.ts"
    },
    "./notes": {
      "@getmadrid/source": {
        "types": "./src/journal-notes.ts",
        "import": "./src/journal-notes.ts",
        "default": "./src/journal-notes.ts"
      },
      "types": "./src/journal-notes.ts",
      "import": "./src/journal-notes.ts",
      "default": "./src/journal-notes.ts"
    },
    "./calendar": {
      "@getmadrid/source": {
        "types": "./src/journal-calendar.ts",
        "import": "./src/journal-calendar.ts",
        "default": "./src/journal-calendar.ts"
      },
      "types": "./src/journal-calendar.ts",
      "import": "./src/journal-calendar.ts",
      "default": "./src/journal-calendar.ts"
    },
    "./month-grid-transition": {
      "@getmadrid/source": {
        "types": "./src/journal-month-grid-transition.ts",
        "import": "./src/journal-month-grid-transition.ts",
        "default": "./src/journal-month-grid-transition.ts"
      },
      "types": "./src/journal-month-grid-transition.ts",
      "import": "./src/journal-month-grid-transition.ts",
      "default": "./src/journal-month-grid-transition.ts"
    },
    "./local-date-key": {
      "@getmadrid/source": {
        "types": "./src/local-date-key.ts",
        "import": "./src/local-date-key.ts",
        "default": "./src/local-date-key.ts"
      },
      "types": "./src/local-date-key.ts",
      "import": "./src/local-date-key.ts",
      "default": "./src/local-date-key.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:getmadrid",
      "type:util",
      "platform:shared"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/note-journal-core",
          "command": "pnpm run build"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@getmadrid/note-doc-plain-text": "workspace:*",
    "chrono-node": "^2.9.1",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
